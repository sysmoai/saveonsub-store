{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash build_all.sh",
  "outputDirectory": "_site",
  "installCommand": "",
  "cleanUrls": true,
  "redirects": [
    { "source": "/subscriptions.html", "destination": "/all.html", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/shop", "destination": "/all.html", "permanent": true },
    { "source": "/products", "destination": "/all.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
