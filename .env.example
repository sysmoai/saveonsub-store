# SaveOnSub Store - Static Site Configuration

# Site Configuration
SITE_URL=https://saveonsub.com
SITE_TITLE=SaveOnSub - Bangladesh's Honest Premium Subscription Store
ENVIRONMENT=development

# Build Configuration
BUILD_LANGUAGE=python3
BUILD_COMMAND=bash build_all.sh

# Payment Configuration
BKASH_ENABLED=true
BKASH_MERCHANT_ID=your_merchant_id
BKASH_APP_KEY=your_app_key
BKASH_APP_SECRET=your_app_secret

NAGAD_ENABLED=true
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_API_KEY=your_nagad_api_key

# WhatsApp Integration
WHATSAPP_PHONE=+880XXXXXXXXX
WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id

# Analytics
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# Contact
CONTACT_EMAIL=contact@saveonsub.com
SUPPORT_PHONE=+880XXXXXXXXX

# Deployment
DEPLOY_TARGET=cloudflare-pages
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
