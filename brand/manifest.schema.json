{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saveonsub.com/brand/manifest.schema.json",
  "title": "SaveOnSub Brand Manifest",
  "type": "object",
  "required": [
    "manifestVersion",
    "brand",
    "authority",
    "palette",
    "assets",
    "platformRouting",
    "socialMetadata",
    "blocked",
    "agentRules",
    "figma",
    "verification"
  ],
  "properties": {
    "manifestVersion": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "domain",
        "lockDate",
        "status"
      ],
      "properties": {
        "name": {
          "const": "SaveOnSub"
        },
        "domain": {
          "const": "https://saveonsub.com"
        },
        "lockDate": {
          "const": "2026-08-19"
        },
        "status": {
          "const": "approved-locked"
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "humanPolicy",
        "agentPolicy",
        "productionPolicy",
        "masterAssets",
        "derivativeGenerator"
      ]
    },
    "palette": {
      "type": "object",
      "required": [
        "teal",
        "navy",
        "white",
        "lightNeutral"
      ]
    },
    "assets": {
      "type": "object",
      "minProperties": 5
    },
    "platformRouting": {
      "type": "object",
      "minProperties": 5
    },
    "blocked": {
      "type": "array"
    },
    "agentRules": {
      "type": "object",
      "required": [
        "must",
        "mustNot"
      ]
    },
    "figma": {
      "type": "object",
      "required": [
        "fileKey",
        "role"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "lastVerified",
        "brandLockMarker"
      ]
    },
    "socialMetadata": {
      "type": "object",
      "required": [
        "status",
        "normalizer",
        "validator",
        "siteName",
        "image",
        "requiredOpenGraph",
        "requiredTwitter",
        "twitterCard",
        "urlRule"
      ],
      "properties": {
        "status": {
          "const": "canonical-deterministic"
        },
        "normalizer": {
          "type": "string"
        },
        "validator": {
          "const": "validate_social_metadata.py"
        },
        "siteName": {
          "const": "SaveOnSub"
        },
        "image": {
          "type": "object",
          "required": [
            "path",
            "url",
            "width",
            "height",
            "alt"
          ],
          "properties": {
            "path": {
              "const": "assets/og-image.png"
            },
            "url": {
              "const": "https://saveonsub.com/assets/og-image.png"
            },
            "width": {
              "const": 1200
            },
            "height": {
              "const": 630
            },
            "alt": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "requiredOpenGraph": {
          "type": "array",
          "minItems": 10
        },
        "requiredTwitter": {
          "type": "array",
          "minItems": 5
        },
        "twitterCard": {
          "const": "summary_large_image"
        },
        "urlRule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": true
}
