/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Service worker must never be long-cached, or users get stuck on old versions
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/assets/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

# Images and icons carry no authority-controlled selling data and change only
# when deliberately re-exported, so a bounded cache is safe for them.
/assets/*.png
  Cache-Control: public, max-age=604800
/assets/*.jpg
  Cache-Control: public, max-age=604800
/assets/*.svg
  Cache-Control: public, max-age=604800
/assets/*.ico
  Cache-Control: public, max-age=604800
/assets/*.woff2
  Cache-Control: public, max-age=604800

# Unfingerprinted executable code and styles must revalidate on every release.
# The release-bound service worker supplies offline behavior without allowing the
# browser HTTP cache to pin stale JS or CSS independently of the release SHA.
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate
