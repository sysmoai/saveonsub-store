/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Service worker must never be long-cached, or users get stuck on old versions
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/assets/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

# Images and icons carry no prices and change only when re-exported, so a long
# cache is safe for them.
/assets/*.png
  Cache-Control: public, max-age=604800
/assets/*.jpg
  Cache-Control: public, max-age=604800
/assets/*.svg
  Cache-Control: public, max-age=604800
/assets/*.ico
  Cache-Control: public, max-age=604800
/assets/*.woff2
  Cache-Control: public, max-age=604800

# Code and price data MUST revalidate.
#
# These files are not fingerprinted (no assets/catalog.<hash>.js), so a long
# max-age pins whatever the visitor first downloaded. The previous rule was
# `/assets/* max-age=604800` with the comment "SW keeps them fresh" — but the
# service worker was cache-first, so it did the opposite. That gave a price
# correction two independent ways to never reach a customer: the HTTP cache and
# the SW cache. assets/catalog.js is the price database for the entire store.
#
# must-revalidate still serves from cache after an ETag check, so this costs a
# conditional request and usually returns 304 — cheap, and never stale.
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate
